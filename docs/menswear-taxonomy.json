 "rules": [
  {
   "id": "knit_garments_need_knit_fabric",
   "if": {
    "category": [
     "knit_top",
     "sweatshirt",
     "knitwear"
    ]
   },
   "then": "fabric must come from knit_structure, not woven_structure"
  },
  {
   "id": "woven_shirts_need_woven_fabric",
   "if": {
    "category": [
     "woven_shirt"
    ]
   },
   "then": "fabric must come from woven_structure"
  },
  {
   "id": "ocbd_requires_oxford_and_button_down",
   "if": {
    "garment": "ocbd"
   },
   "then": "weave=oxford AND collar=button_down"
  },
  {
   "id": "flannel_is_not_a_pattern",
   "then": "'flannel' is only a woven_structure/finish; never a pattern value"
  },
  {
   "id": "camp_collar_hem",
   "if": {
    "collar": "camp"
   },
   "then": "hem in [straight, straight_with_vents]; usually untucked"
  },
  {
   "id": "french_cuff_collar",
   "if": {
    "cuff": "french"
   },
   "then": "collar not in [button_down, camp, band, western]"
  },
  {
   "id": "pearl_snap_context",
   "if": {
    "closure_material": "pearl_snap"
   },
   "then": "garment in [western_shirt, work_shirt, overshirt]"
  },
  {
   "id": "henley_has_no_collar",
   "if": {
    "garment": "henley"
   },
   "then": "collar=none"
  },
  {
   "id": "fiber_gauge",
   "then": "knit gauge must fall within fiber_gauge_plausible[fiber]"
  },
  {
   "id": "corduroy_needs_wale",
   "if": {
    "weave": "corduroy"
   },
   "then": "specify corduroy_wales_per_inch; shirts usually needlecord/standard"
  },
  {
   "id": "dress_shirt_no_casual_fabrics",
   "if": {
    "garment": "dress_shirt"
   },
   "then": "weave not in [flannel, corduroy, canvas, denim, madras, seersucker]"
  },
  {
   "id": "pattern_needs_scale",
   "if": {
    "pattern_not": "solid"
   },
   "then": "pattern_scale and pattern_orientation required"
  },
  {
   "id": "breton_horizontal",
   "if": {
    "pattern": "breton_stripe"
   },
   "then": "pattern_orientation=horizontal"
  },
  {
   "id": "kangaroo_pullover",
   "if": {
    "pockets": "kangaroo"
   },
   "then": "placket=none"
  }
 ],
